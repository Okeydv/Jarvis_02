# Скопируйте этот файл в .env и впишите свои ключи.
# Файл .env не попадает в git (см. .gitignore).

# GigaChat: ключ авторизации (Authorization key) из личного кабинета
# https://developers.sber.ru/studio → проект GigaChat API → «Настройки API» → «Получить ключ»
GIGACHAT_CREDENTIALS=

# Gemini: бесплатный API-ключ из Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Qwen через BazaarLink: ключ вида sk-bl-… — https://bazaarlink.ai → API Keys
# (бесплатная модель qwen/qwen3.7-flash:free — до 50 запросов в день)
BAZAARLINK_API_KEY=
